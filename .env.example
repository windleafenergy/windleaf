# THIS FILE IS A TEMPLATE. Next.js does not read it — it reads .env.local,
# .env.production and .env, all of which are gitignored. Editing values here
# changes nothing on its own.
#
#   Local development:  cp .env.example .env.local   (then edit .env.local)
#   Deployment:         set each variable in the hosting provider's dashboard
#                       (Vercel → Project → Settings → Environment Variables),
#                       then REDEPLOY — NEXT_PUBLIC_* values are compiled into
#                       the pages at build time, so saving a variable does not
#                       change a deployment that already exists.
#
# NEXT_PUBLIC_* values are shipped in the browser bundle — never put a secret
# behind that prefix. The unprefixed ones below are server-only.

# The live origin. Drives metadataBase, every canonical tag, sitemap.xml,
# robots.txt and the JSON-LD. Set this to the real domain before launch —
# until it is set, preview deployments serve noindex.
NEXT_PUBLIC_SITE_URL=https://www.windleafenergy.com

# Event banners (trade shows, conferences) as a JSON array.
#
#   Fields: id and heading are required. text, details, strip, ctaLabel,
#   ctaHref and enabled are optional.
#   - strip    one-line form, for <EventBanner variant="strip" />
#   - enabled  set false to hide one event without deleting it
#
# Set to [] to hide every event banner site-wide.
# Unset falls back to the defaults in src/lib/events.ts.
#
# To span lines it MUST be wrapped in single quotes. An unquoted value stops at
# the first newline, so a bare multi-line array reaches the app as "[" — invalid
# JSON, which falls back to the defaults in lib/events.ts without any visible
# sign that the value was ignored. Single quotes, not double: the JSON itself is
# full of double quotes.
#
# Vercel's dashboard field is a plain textarea — paste the JSON there WITHOUT
# the surrounding quotes. The quoting below is .env file syntax, not part of
# the value.
NEXT_PUBLIC_EVENTS='[
  {
    "id": "windergy-india-2026",
    "heading": "Meet Windleaf at Windergy India 2026",
    "text": "Visit us to discuss blade engineering, inspection and our technology initiatives.",
    "details": "October 7–9, 2026 · Chennai Trade centre, Nandambakkam · Hall 2, S3",
    "strip": "Windergy India 2026 — October 7–9, 2026 · Chennai Trade centre, Nandambakkam · Hall 2, S3",
    "ctaLabel": "Book a Meeting",
    "ctaHref": "/contact"
  }
]'

# ─── Enquiry form delivery (Resend) ──────────────────────────────────────────
# SERVER-ONLY. No NEXT_PUBLIC_ prefix, deliberately — that prefix would inline
# the key into the browser bundle where anyone could read and use it.
# Without RESEND_API_KEY the form validates, then tells the user to email
# directly instead of silently discarding what they wrote.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries land. Defaults to CONTACT.email in src/content/site.ts.
ENQUIRY_TO=mg@windleafenergy.com

# The From address. MUST be on a domain verified in Resend — Resend will not
# send from an address it cannot prove you own, and an unverified domain comes
# back as an error in the response body rather than as a thrown exception.
# Before the real domain is verified, onboarding@resend.dev works but can only
# deliver to the Resend account owner's own address.
ENQUIRY_FROM=Windleaf Website <enquiries@send.windleafenergy.com>
